{
  "name": "pi-game-studio",
  "version": "1.10.0",
  "description": "Compact AI Game Studio for Pi — 8 Core roles + 1 Engine Specialist (8+1), 6 ODD skills pipeline",
  "license": "MIT",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=22.6"
  },
  "author": "Alexis <alexis@bytetech.com.ar>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alitoxx/pi-game-studio.git"
  },
  "homepage": "https://github.com/Alitoxx/pi-game-studio",
  "bugs": {
    "url": "https://github.com/Alitoxx/pi-game-studio/issues"
  },
  "keywords": [
    "pi-package",
    "game-development",
    "game-studio",
    "gamedev"
  ],
  "bin": {
    "pi-studio": "bin/pi-studio.mjs"
  },
  "files": [
    "bin/",
    "agents/",
    "skills/",
    "extensions/",
    "chains/",
    "scripts/",
    "docs/",
    "starters/",
    "themes/",
    "project.yaml",
    "models.default.json",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:soak": "bash scripts/soak-test.sh",
    "assets:placeholders": "node scripts/generate-placeholders.js",
    "build:web": "bash scripts/build-web.sh",
    "serve:web": "node scripts/serve-web.js",
    "synth": "node scripts/synth-studio.js"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "@types/jest": "^29.0.0",
    "jest": "^29.0.0"
  },
  "pi": {
    "image": "docs/assets/mascot.png",
    "skills": [
      "./skills"
    ],
    "extensions": [
      "./extensions"
    ],
    "themes": [
      "./themes"
    ]
  }
}
